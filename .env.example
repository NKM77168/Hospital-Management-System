# ─────────────────────────────────────────────────
#  Hospital Management System — Environment Config
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file to git.
# ─────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>

# Database name (will be created automatically)
DB_NAME=hospital_db

# Flask secret key — change this to a long random string in production
SECRET_KEY=your-super-secret-key-change-this
